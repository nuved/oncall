# Reference listing of the variables the docker compose files read.
#
# Do not fill this in by hand. Run
#
#     ./scripts/init-env.sh
#
# instead: it writes a .env next to your docker-compose.yml with a random
# value for every secret below, mode 600, and prints the Grafana admin
# password once. Rotate everything later with `./scripts/init-env.sh --force`.
#
# The secrets here are deliberately empty. Copying this file over leaves them
# empty, and `docker compose up` then stops with "run scripts/init-env.sh
# first" rather than starting with blank passwords.

# ---------------------------------------------------------------------------
# Deployment settings -- safe to edit
# ---------------------------------------------------------------------------

# Root URL of the OnCall engine, used as BASE_URL by the engine.
DOMAIN=http://localhost:8080

# Which compose profiles to start. Drop with_grafana to use your own Grafana;
# add with_prometheus for a local Prometheus scraping OnCall metrics.
COMPOSE_PROFILES=with_grafana

# Tag of the grafana/* image used by the bundled grafana service.
GRAFANA_IMAGE=grafana:latest

# Grafana admin username (the password is GRAFANA_ADMIN_PASSWORD below).
GRAFANA_USER=admin

# Prometheus exporter, docker-compose.yml only. To enable it set this to True
# and put a token in PROMETHEUS_EXPORTER_SECRET matching prometheus.yml.
FEATURE_PROMETHEUS_EXPORTER_ENABLED=false
PROMETHEUS_EXPORTER_SECRET=

# docker-compose-mysql-rabbitmq.yml only: which MySQL account and host the
# engine and Grafana connect to.
MYSQL_USER=root
MYSQL_HOST=mysql

# ---------------------------------------------------------------------------
# Secrets -- generated by scripts/init-env.sh, never commit or share them
# ---------------------------------------------------------------------------

# Django secret key for the engine, 64 random alphanumeric characters.
SECRET_KEY=

# django-mirage-field encryption of stored credentials: 40 random characters
# and exactly 16 for the IV. settings.hobby (the settings module both compose
# files use) derives MIRAGE_SECRET_KEY from SECRET_KEY and pins a fixed IV, so
# these two only take effect with a settings module that reads them, such as
# settings.dev.
MIRAGE_SECRET_KEY=
MIRAGE_CIPHER_IV=

# MySQL, docker-compose-mysql-rabbitmq.yml only. Both values must stay equal
# while MYSQL_USER is root: the engine, the healthcheck and Grafana all
# authenticate as root with MYSQL_PASSWORD.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# RabbitMQ, docker-compose-mysql-rabbitmq.yml only. The username is rabbitmq.
RABBITMQ_PASSWORD=

# Grafana admin password, for the bundled grafana service. Printed once by
# scripts/init-env.sh.
GRAFANA_ADMIN_PASSWORD=

# Shared password for the demo accounts a demo-seeding script may create.
# Written only by `./scripts/init-env.sh --demo`; unused by the compose files.
DEMO_USERS_PASSWORD=
