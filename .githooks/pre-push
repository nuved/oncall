#!/usr/bin/env bash
# Runs the unit tests before every push. Install with `make install-git-hooks`.
#
# Frontend (jest, tsc) and backend-plugin (go test) tests run natively; the engine's
# pytest suite is large, so it runs only when PRE_PUSH_ENGINE_TESTS=1 and the
# oncall_engine container from `make start` is up. Skip everything once with
# `git push --no-verify`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: frontend type-check and unit tests"
(
  cd grafana-plugin
  if [ ! -d node_modules ]; then
    echo "node_modules missing, installing with pnpm 9 (CI's version)"
    npx -y pnpm@9.1.4 install --frozen-lockfile
  fi
  ./node_modules/.bin/tsc --noEmit
  PLUGIN_ID=grafana-oncall-app TZ=UTC ./node_modules/.bin/jest --silent --testNamePattern '^((?!@london-tz).)*$'
  PLUGIN_ID=grafana-oncall-app TZ=Europe/London ./node_modules/.bin/jest --silent --testNamePattern '@london-tz'
)

echo "pre-push: backend plugin (Go) tests"
(cd grafana-plugin && go test ./...)

if [ "${PRE_PUSH_ENGINE_TESTS:-0}" = "1" ]; then
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx oncall_engine; then
    echo "pre-push: engine tests (pytest in the oncall_engine container)"
    make test
  else
    echo "pre-push: PRE_PUSH_ENGINE_TESTS=1 but oncall_engine is not running; start it with 'make start'" >&2
    exit 1
  fi
else
  echo "pre-push: engine tests skipped (set PRE_PUSH_ENGINE_TESTS=1 to run them, or run 'make test')"
fi
